{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/libraries/glad/include",
                "${workspaceFolder}/libraries/glfw/include",
                "C:/Program Files/C++ Compiler/mingw64/include",
                "${workspaceFolder}/header"
            ],
            "defines": [
                "GLFW_INCLUDE_NONE"
            ],
            "compilerPath": "C:/Program Files/C++ Compiler/mingw64/bin/gcc.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/**",
                    "${workspaceFolder}/libraries/glad/include",
                    "${workspaceFolder}/libraries/glfw/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}